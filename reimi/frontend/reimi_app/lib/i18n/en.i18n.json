  "weatherPersonalityConceptPage": {
    "title": "Weather Personality Assessment",
    "contentText": {
      "contentTitle": "About the Assessment",
      "contentText1": "If you were to be reborn as an animal,\n\n",
      "contentText2": "based on your behavior and personality\ntoward weather in your past life,\n",
      "contentText3": "the gods will objectively judge you\n\n",
      "contentText4": "and classify you into one of 16 character types\n\n",
      "contentText5": "",
      "contentText6": "Answer 16 questions to discover\nyour Weather Personality type"
    }
  },
